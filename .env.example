# Firebase web app config — Firebase console → Project settings → Your apps → Web app.
# These values are public by design; Firestore Security Rules + App Check protect the data.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# development | staging | production (shown in Settings; production forbids emulators).
NEXT_PUBLIC_APP_ENV=development

# Firebase App Check with reCAPTCHA v3 (console → App Check → register the web app).
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
# Local/CI only: print an App Check debug token to the console (register it in the console).
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG=false

# Firebase Performance Monitoring (page load + network traces). Recommended in production.
NEXT_PUBLIC_FIREBASE_PERFORMANCE=false

# Set to "true" to use the local Auth (9099) and Firestore (8080) emulators.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
