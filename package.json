{
  "name": "expense-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "firebase emulators:start --only hosting --project demo-ledger",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-ledger 'vitest run --config vitest.rules.config.mts'",
    "icons": "node scripts/generate-icons.mjs",
    "emulators": "firebase emulators:start --project demo-ledger",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules,firestore:indexes",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-ledger 'playwright test'",
    "splash": "node scripts/generate-splash.mjs",
    "prebuild": "node scripts/check-env.mjs",
    "deploy:rules:staging": "firebase deploy --only firestore:rules,firestore:indexes -P staging",
    "deploy:rules:production": "firebase deploy --only firestore:rules,firestore:indexes -P production",
    "test:e2e:prod": "node scripts/e2e-prod.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "firebase": "^12.19.0",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.3",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "firebase-tools": "^15.32.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
